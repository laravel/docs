---
import { Icon } from '@astrojs/starlight/components';
interface Props {
  label: string;
  accessibleLabel: string;
  icon?: 'translate';
  items: { label: string; href: string; lang?: string; current?: boolean }[];
}
const { label, accessibleLabel, icon, items } = Astro.props;
---

<docs-dropdown>
  <details>
    <summary aria-label={`${accessibleLabel}: ${label}`}>
      {icon && <Icon name={icon} size="1.25rem" />}
      <span>{label}</span>
      <Icon name="down-caret" size="1rem" />
    </summary>
    <ul aria-label={accessibleLabel}>
      {items.map(item => (
        <li><a href={item.href} lang={item.lang} aria-current={item.current ? 'true' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </details>
</docs-dropdown>

<style>
  docs-dropdown { position: relative; }
  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    cursor: pointer;
    list-style: none;
    border-radius: 0.25rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--sl-color-text-accent); }
  summary:focus-visible, a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    width: max-content;
    min-width: 100%;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    box-shadow: 0 0.5rem 1.5rem #0003;
  }
  a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  a:hover, a[aria-current] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
  }
</style>

<script>
  class DocsDropdown extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector('details')!;
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          details.open = false;
          this.querySelector('summary')?.focus();
        }
      });
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget as Node | null)) details.open = false;
      });
      document.addEventListener('click', this.closeOutside);
    }
    disconnectedCallback() {
      document.removeEventListener('click', this.closeOutside);
    }
    closeOutside = (event: MouseEvent) => {
      if (!this.contains(event.target as Node)) this.querySelector('details')!.open = false;
    };
  }
  customElements.define('docs-dropdown', DocsDropdown);
</script>
