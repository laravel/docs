---
import config from 'virtual:starlight/user-config';
import Dropdown from './Dropdown.astro';
import VersionSelect from './VersionSelect.astro';

const currentLocale = Astro.locals.starlightRoute.locale;
const locales = Object.entries(config.locales);
const currentLabel = locales.find(([code]) => code === currentLocale)?.[1]?.label || '';
const segments = Astro.url.pathname.split('/').filter(Boolean);
if (locales.some(([code]) => code === segments[0])) segments.shift();
const pagePath = segments.join('/');
const items = locales.map(([code, locale]) => ({
  label: locale!.label,
  href: `/${code === 'root' ? '' : `${code}/`}${pagePath}${pagePath ? '/' : ''}`,
  lang: locale!.lang,
  current: code === currentLocale,
}));
---

<div class="selectors">
  <VersionSelect />
  <Dropdown label={currentLabel} accessibleLabel={Astro.locals.t('languageSelect.accessibleLabel')} icon="translate" items={items} />
</div>

<style>
  .selectors { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem; }
</style>
